# Postgres — Neon, Supabase, or local
DATABASE_URL=postgresql://user:pass@localhost:5432/foundry

# Public base URL, used to build download links sent to WordPress installs
APP_URL=http://localhost:3000

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Required when self-hosting behind a proxy or on any non-Vercel host.
# Without it Auth.js rejects every request with UntrustedHost.
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LOCAL ONLY. Enables a password-less sign-in form that accepts any email.
# Never set this on a deployed environment.
FOUNDRY_DEV_LOGIN=false

# Cloudflare R2 (S3-compatible, zero egress fees)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=foundry-products

# Payments — pick one to start
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard webhook settings — not the API secret above.
RAZORPAY_WEBHOOK_SECRET=
